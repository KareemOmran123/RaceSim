# Local development examples only. Copy to .env and choose local passwords.
POSTGRES_USER=racesim
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_DB=racesim
POSTGRES_PORT=5433
MONGO_INITDB_ROOT_USERNAME=racesim
MONGO_INITDB_ROOT_PASSWORD=local-mongo-change-me
MONGO_PORT=27017
# Future Simulation API connection; keep credentials/port aligned with the above.
# Percent-encode special characters in URI credentials.
MONGODB_URL=mongodb://racesim:local-mongo-change-me@127.0.0.1:27017/racesim?authSource=admin
CORE_API_PORT=3001
SIMULATION_API_PORT=8000
# Reserved for future server-side Next.js calls; not used in Milestone 1.
CORE_API_URL=http://127.0.0.1:3001
