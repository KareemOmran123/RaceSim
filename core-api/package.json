{
  "name": "racesim-core-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/server.ts",
